{
  "name": "oauth2-server-grant-type-facebook",
  "version": "0.3.0",
  "description": "Facebook grant type for oauth2-server",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": "https://github.com/jpalumickas/node-oauth2-server-grant-type-facebook",
  "author": {
    "name": "Justas Palumickas",
    "email": "jpalumickas@gmail.com",
    "url": "https://jpalumickas.com"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2"
  },
  "peerDependencies": {
    "oauth2-server": "3.x"
  },
  "devDependencies": {
    "@types/oauth2-server": "^3.0.18",
    "oauth2-server": "^3.1.1",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "keywords": [
    "oauth2",
    "oauth2-server",
    "grant-type",
    "facebook"
  ]
}
